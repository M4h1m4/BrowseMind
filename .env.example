# BrowseMind Environment Variables
# Copy to .env and fill in values

# REQUIRED: OpenAI API key for LLM-driven capture
OPENAI_API_KEY=sk-...

# Optional: Custom ports (defaults shown)
# PORT=3000
# MEDTRACK_PORT=4300
# STOCKWISE_PORT=4301

# Database paths (automatically created if not exist)
# MEDTRACK_DB_PATH=./db/meditrack.db
# STOCKWISE_DB_PATH=./db/stockwise.db
# BROWSEMIND_DB_PATH=./db/artifacts.db