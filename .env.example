PORT=3000

# LLM — required for capture (Phase 2)
OPENAI_API_KEY=
MAX_STEPS_CAPTURE=25

# OrangeHRM demo — for E2E testing only
ORANGEHRM_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# ExpandTesting Notes demo — for real-website E2E testing only.
# No credentials here by design: capture pauses at login_required, a human logs
# in by hand, and the session is stored for replay to reuse.
NOTES_URL=https://practice.expandtesting.com/notes/app

# Tenant defaults — for local development
DEFAULT_TENANT_ID=default

# Test settings
# DATABASE_PATH=:memory:   # set this in test environment
# RUN_E2E=true             # set this to enable E2E tests that open a real browser
